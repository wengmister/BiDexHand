<launch>
    <arg name="mode" default="piano" description="Mode for apriltag detection: piano or calibration" />

    <node pkg="apriltag_ros" exec="apriltag_node" output="screen" args="--ros-args --log-level fatal">
        <remap from="image_rect" to="/camera/wrist/color/image_rect_raw" />
        <remap from="camera_info" to="/camera/wrist/color/camera_info" />
        <param name="use_sim_time" value="false"/>
        
        <param from="$(find-pkg-share hand_calibration)/config/atag_$(var mode).yaml" />
    </node>
</launch>