<launch>
    <arg name="usb" default="/dev/ttyACM0"/>
    <node pkg="hand_servo_control" exec="multi_servo_control" name="servo_control_node" output="screen">
      <param name="usb_port" value="$(var usb)" />
      <param name="mode" value="streaming" />
    </node>

    <!-- calibrated control node -->
    <node pkg="hand_servo_control" exec="calibrated_control_node" name="calibrated_control_node" output="screen"/>

    <!-- calibrated GUI -->
    <node pkg="hand_servo_control" exec="calibrated_control_gui" name="calibrated_control_gui_node" output="screen"/>
</launch>
  