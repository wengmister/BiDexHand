# Inverse Kinematics Service
# Compute joint angles to reach a target position for a specified finger chain

string chain_name                # finger chain name (thumb, index, middle, ring, pinky)
geometry_msgs/Point target_position  # target position to reach
float64[] initial_guess_deg      # optional initial guess for joint angles in degrees
---
bool success                    # whether IK converged
float64[] joint_angles_deg      # computed joint angles in degrees
geometry_msgs/Point actual_position  # actual tip position achieved
string method                   # optimization method used
string message                  # status message